# /opt/production-pos/.env — start from point-of-sales/.env.example, then set at least:
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pos.kgarden.co.th
APP_MODE=warehouse
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=point_of_sales
DB_USERNAME=pos
DB_PASSWORD=

SPOOLMAN_ENABLED=true
SPOOLMAN_BASE_URL=http://spoolman:7912
SPOOLMAN_WS_URL=ws://spoolman:7912/api/v1/socket
SPOOLMAN_INTEGRATION_TOKEN=

INERTIA_SSR_ENABLED=false

# docker compose only
DB_ROOT_PASSWORD=
# cloudflared tunnel token production-pos
TUNNEL_TOKEN=
